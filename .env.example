ORACLE_USER_NISHA=NISHA
ORACLE_PASSWORD_NISHA=replace-with-local-db-password
ORACLE_USER_NAVEEN=NAVEEN
ORACLE_PASSWORD_NAVEEN=replace-with-local-db-password
VECTORDB_USER=VECTORDB
VECTORDB_PASSWORD=replace-with-vectordb-password
ORACLE_CONNECT_STRING=replace-with-adb-service-name
ORACLE_WALLET_LOCATION=/path/to/wallet
ORACLE_DB_CONFIG_DIR=/path/to/wallet
# Optional for encrypted PEM/P12 wallets:
ORACLE_DB_WALLET_PASSWORD=replace-with-wallet-password-if-needed
# Optional for SSO wallets with Oracle Instant Client:
ORACLE_THICK_MODE=false
ORACLE_CLIENT_LIB_DIR=/path/to/instantclient
SESSION_SECRET=replace-with-long-random-string

# Optional OCI Generative AI Guardrails. Keep OCI credentials outside the repo.
OCI_GUARDRAILS_COMPARTMENT_ID=
OCI_GUARDRAILS_REGION=us-chicago-1
OCI_GUARDRAILS_VERSION=
OCI_CONFIG_FILE=/path/to/.oci/config
OCI_CONFIG_PROFILE=DEFAULT
